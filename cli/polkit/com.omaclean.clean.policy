<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!--
  由经过核验的安装器原子发布到 /usr/share/polkit-1/actions/。
  exec.path 注解绑定到 root 属主的版本化 helper；CLI 只传 id，
  命令与参数全部由 helper 决定。
-->
<policyconfig>
  <vendor>omaclean</vendor>
  <vendor_url>https://github.com/tenngoxars/omarchy-omaclean</vendor_url>

  <action id="com.omaclean.clean">
    <description>Clean system caches and logs</description>
    <message>Authentication is required to clean system caches and logs</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/omaclean/omaclean-priv-55f8c90b69ce7b88df5cd9d00c566d0757a8acbdbeccbd3c71ace96d708a4f8a</annotate>
  </action>
</policyconfig>
