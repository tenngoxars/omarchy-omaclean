#!/bin/bash
set -euo pipefail
PATH=/usr/bin:/bin

readonly HELPER_SHA=31af0b51a453d51d3d2808ee97380983a970edca74090d60254cfc96a96ddef6
readonly POLICY_SHA=1877a56ca3a8923313e3c1bd5709a30060520c6ee9d8742386c4c809665a182c
readonly HELPER_DIR=/usr/local/lib/omaclean
readonly HELPER_PATH="$HELPER_DIR/omaclean-priv-$HELPER_SHA"
readonly POLICY_DIR=/usr/share/polkit-1/actions
readonly POLICY_PATH="$POLICY_DIR/com.omaclean.clean.policy"

fail() { printf 'omaclean: %s\n' "$*" >&2; exit 1; }

[[ $EUID == 0 && $# == 1 && $1 =~ ^[0-9a-f]{40}$ ]] || fail 'root and a reviewed 40-character commit SHA are required'
root=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
[[ $root == /root/omaclean-install-* && ! -L $root ]] || fail 'only a root-owned independent checkout under /root is accepted'
[[ $(git -C "$root" rev-parse --verify HEAD) == "$1" ]] || fail 'checkout commit differs from reviewed SHA'
tree_status=$(git -C "$root" status --porcelain --untracked-files=no) || fail 'cannot verify checkout'
[[ -z $tree_status ]] || fail 'checkout has local changes'

trusted_dir() {
    local owner mode
    [[ -d $1 && ! -L $1 ]] || return 1
    read -r owner mode < <(stat -c '%u %a' -- "$1") || return 1
    [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] && (( (8#$mode & 0022) == 0 ))
}
if ! trusted_dir /root || ! trusted_dir "$root" || ! trusted_dir "$root/cli" ||
    ! trusted_dir "$root/cli/libexec" || ! trusted_dir "$root/cli/polkit"; then
    fail 'checkout directory is not root-owned and non-writable'
fi

helper="$root/cli/libexec/omaclean-priv"
policy="$root/cli/polkit/com.omaclean.clean.policy"
[[ -f $helper && ! -L $helper && -f $policy && ! -L $policy ]] || fail 'artifacts are missing or symlinked'

verify() {
    local actual
    actual=$(sha256sum -- "$1") || fail "cannot hash $1"
    [[ ${actual%% *} == "$2" ]] || fail "artifact differs from reviewed bytes: $1"
}
verify "$helper" "$HELPER_SHA"
verify "$policy" "$POLICY_SHA"

trusted_dir /usr/local/lib || fail 'target parent directory is not root-owned and non-writable'
if [[ ! -e $HELPER_DIR && ! -L $HELPER_DIR ]]; then
    install -d -m755 -- "$HELPER_DIR"
fi
if ! trusted_dir "$HELPER_DIR" || ! trusted_dir "$POLICY_DIR"; then
    fail 'target directory is not root-owned and non-writable'
fi
helper_tmp=$(mktemp "$HELPER_DIR/.omaclean-priv.XXXXXXXX")
policy_tmp=''
trap 'rm -f -- "$helper_tmp" "$policy_tmp"' EXIT
policy_tmp=$(mktemp "$POLICY_DIR/.com.omaclean.clean.XXXXXXXX")
install -m755 -- "$helper" "$helper_tmp"
install -m644 -- "$policy" "$policy_tmp"
verify "$helper_tmp" "$HELPER_SHA"
verify "$policy_tmp" "$POLICY_SHA"

mv -fT -- "$helper_tmp" "$HELPER_PATH"
helper_tmp=''
mv -fT -- "$policy_tmp" "$POLICY_PATH"
policy_tmp=''
rm -f -- "$HELPER_DIR/omaclean-priv"
printf 'Verified privileged component installed: %s\n' "$HELPER_PATH"
